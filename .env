# Configurações do Gmail Manager
# Para usar com Gmail real, substitua pelos seus dados:
# 1. Acesse sua conta Google
# 2. Vá em Segurança → Verificação em duas etapas
# 3. Em "Senhas de app", gere uma nova senha
# 4. Use essa senha (16 caracteres) abaixo

GMAIL_EMAIL=teste@gmail.com
GMAIL_APP_PASSWORD=testpassword123
DOWNLOAD_DIR=downloads
